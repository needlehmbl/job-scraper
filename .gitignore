# Secrets -- never commit
.env
*.env

# Python
venv/
__pycache__/
*.pyc

# Personal / runtime data (keep local)
applications.xlsx
runs.log
raw_jobs.csv
.notify_state.json
resumes/
resume_bank.yaml
resume_bank.extracted.yaml
usage_state.json

# Generated at release time by installer/make-tarball.sh and the Windows
# release job; never committed. api/routes/admin.py reads it to report the
# installed version -- see AGENTS.md.
/VERSION

# PyInstaller output from a local frozen build (see AGENTS.md)
/build/
/dist/

# Office lock files
*.~lock.*#

# Local servers / dashboard
api.log
dashboard.log
dashboard/dist/
dashboard/node_modules/
dashboard/.vite/
# Demo recording intermediates (raw takes); the final cut is committed.
demo/takes/
# Playwright login cookies -- never commit
storage_state/
